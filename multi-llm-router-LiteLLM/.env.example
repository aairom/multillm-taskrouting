# ── Ollama endpoint ──────────────────────────────────────────────────────────
# LiteLLM Router routes all calls to this Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# ── Model tier mapping — 4 providers via Ollama ───────────────────────────────
# Each tier maps a symbolic label to a concrete Ollama model name.
# LiteLLM will prepend "ollama/" and route through OLLAMA_BASE_URL.
# Edit these to swap providers without touching application code.

# Tier 1 — light / fast / cheap
# IBM Granite 4.1 3B — ideal for documentation, summaries, simple QA
LLM_LIGHT=granite4.1:3b

# Tier 2 — medium / general-purpose
# Meta LLaMA 3.2 — solid all-rounder for code generation and CRUD tasks
LLM_MEDIUM=llama3.2:latest

# Tier 3 — balanced / reasoning
# Google Gemma 3 4B — strong reasoning with a small footprint; good for tests and analysis
LLM_BALANCED=gemma3:4b

# Tier 4 — heavy / powerful
# Mistral Small 3.2 — largest local model; best for security-sensitive code, auth, architecture
LLM_HEAVY=mistral-small3.2:latest

# ── LiteLLM Router settings ───────────────────────────────────────────────────
# LITELLM_ROUTING_STRATEGY options:
#   simple-shuffle (default)  — random weighted pick, best for single-node Ollama
#   latency-based-routing     — tracks p50 latency per deployment (multi-node)
#   cost-based-routing        — picks cheapest deployment that fits budget
LITELLM_ROUTING_STRATEGY=simple-shuffle

# ── Application settings ──────────────────────────────────────────────────────
# Set to 1 to skip actual LLM calls (shows routing table only)
DRY_RUN=0
